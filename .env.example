# the postgres database url
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/vibe

# the old supabase project, only used by the migration and keepalive scripts
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# the cloudinary account used for the song files
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# the google oauth desktop app client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_ISSUER=https://accounts.google.com

# the secret used to sign the session tokens, use at least 32 characters
SESSION_SECRET=change-this-to-a-long-random-string
SESSION_TTL_DAYS=30
SESSION_ISSUER=vibe-backend
