# the postgres database url, it is only needed for the migration scripts
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/vibe

# the old supabase project, only used by the migration and keepalive scripts
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# which database the app talks to, sqlmodel or dynamodb
DB_BACKEND=dynamodb
DYNAMODB_TABLE_NAME=vibe
AWS_REGION=ap-south-1

# the google oauth client, a web type client with the redirect
# http://localhost:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_ISSUER=https://accounts.google.com

# the session token we sign ourselves after the google login, when it is empty
# the secret is read from the parameter store
SESSION_SECRET=
SESSION_SECRET_PARAMETER=/vibe/session-secret
SESSION_TTL_DAYS=30
SESSION_ISSUER=vibe-backend

# the s3 bucket that holds the song files
S3_BUCKET=
S3_REGION=ap-south-1
MEDIA_BASE_URL=
S3_UPLOAD_URL_EXPIRY=900
